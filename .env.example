# Docker Compose
PESTSCOPE_PORT=8000

# Local Python defaults. Docker Compose maps these to /app paths inside the
# container, while local uvicorn can use the relative paths below.
PESTSCOPE_MODEL_BUNDLE=artifacts/models/pestnet_s_latest
PESTSCOPE_CLASS_REVIEW=configs/data/ip102_class_review.yaml
PESTSCOPE_DEVICE=auto
PESTSCOPE_MAX_UPLOAD_MB=10
PESTSCOPE_MAX_PIXELS=16000000
# Leave blank to use thresholds stored in the model bundle metadata.
PESTSCOPE_ACCEPT_THRESHOLD=
PESTSCOPE_UNCERTAIN_THRESHOLD=
PESTSCOPE_ALLOW_DEMO_MODEL=true
PESTSCOPE_FETCH_DEMO_IMAGES=false
PESTSCOPE_DEMO_CACHE_DIR=artifacts/demo_assets
PESTSCOPE_REVIEW_DB=artifacts/reviews.sqlite3
